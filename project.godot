;   param=value ; assign values to parameters

config_version=5

[application]

config/name="rpg"
run/main_scene="uid://dblgm5ykbgqum"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

RoomChangeGlobal="*uid://cah66quctdohc"
Transition="*uid://d2ne35ucdgjui"
