[node name="LastFlame" unique_id=1932718674 node_paths=PackedStringArray("area2d") instance=ExtResource("1_qrja6")]
script = ExtResource("1_nm6hn")
dialogue = "=== start
	Purple flame: Hello traveller.
	$player: [a fire that talks? what is this?]
	$player: Wh- what are you?
	Purple flame: I am a projection of the Last Flame.
	Projection of the Last Flame: The Hotlands draw their power from living flames; the Last Flame is tasked with keeping the Hotlands together when all other flames go out.
	Projection of the Last Flame: Each flame combines and balances two colors. Observe; the Last Flame balances red and blue, so it appears purple, and so do I.
	Projection of the Last Flame: I want you to prove your knowledge of the Flames. In exchange, I offer a powerful gift that is sure to help you out.
	Projection of the Last Flame: Come back to show off the knowledge you have attained.
	$player: Alright!
	>> end
===

=== met
	Projection of the Last Flame: So, do you have the knowledge that I expect?
	$player: I sure hope I do!
	Projection of the Last Flame: Let us test it.
	Projection of the Last Flame: What color does the First Flame appear in?
		* Orange -> correct_first
		* Green -> wrong
		* Purple -> wrong
===

=== correct_first
	Projection of the Last Flame: What color does the Second Flame appear in?
		* Orange -> wrong
		* Green -> wrong
		* Purple -> correct_second
===

=== correct_second
	Projection of the Last Flame: What color does the Third Flame appear in?
		* Orange -> wrong
		* Green -> wrong
		* Purple -> correct_third
===

=== correct_third
	Projection of the Last Flame: What color does the Fourth Flame appear in?
		* Orange -> wrong
		* Green -> correct_all
		* Purple -> wrong
===

=== correct_all
	Projection of the Last Flame: Very well. It is clear you've explored our lands thoroughly. Here is your reward.
    $player: Thank you mysterious flame!
    >> end
===

=== wrong
    Projection of the Last Flame: A traveller is not worthy of this power unless they know enough about our lands.
    Projection of the Last Flame: Explore more and come back later.
    >> end
==="
