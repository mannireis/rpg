[node name="Rebeka" unique_id=180817783 node_paths=PackedStringArray("area2d", "animation") instance=ExtResource("1_qrja6")]
script = ExtResource("1_ilpv8")
follow_speed = 30.0
npc_name = &"rebeka"
dialogue = "=== start
	Rebeka: RHGRHHR It's prohibited to pass here.
	$player: Why?
	Rebeka: It's too dangerous for weaklings like you.
	Rebeka: Win me in a battle to prove you are strong enough.
	* Battle -> battle_init[0]
	* Flirt -> flirt
	* Run -> run
===

=== ran
	Rebeka: GHRH you again really? What do you want now.
	* Battle -> battle_talk
	* Run -> run_again
===

=== battle_talk
	$player: I wanna battle!
	* Battle -> battle_init[0]
===

=== run_again
	$player: Sorry for bothering you!
	Rebeka: Coward!!
	>> run
===

=== battle_won
	Rebeka: RHG you have won my respect do you want to come with me?
	* Yes -> follow
	* No -> dont_follow
===

=== follow
	$player: yesyesyes!
	Rebeka: GRHH don't be too enthusiastic.
	>> end
===

=== dont_follow
	$player: No thank you!
	>> end
===

=== frens
	$player: so cool we are friends now.
	Rabeka: We are not friends.
	>> goodbye
===

=== run
	>> end
===

=== flirt
	$player: That bandana you have on is pretty :3
	Rebeka: Thanks.
	* Compliment hair -> hair
	* Compliment axe -> axe
	* Goodbyes -> goodbye
===

=== hair
	$player: Y'know your hair is really pretty as well.
	Rebeka: Your sweet words don't show me your strength.
	>> end
===

=== axe
	$player: woa that axe you have there is really cool!
	Rebeka: That's not an axe, silly. It's a halberd. Thank you though.
	$player: Oh, sorry, I didn't know. You can always learn tho!
	Rebeka: I guess.
	$player: Can I go thru now ?
	Rebeka: Fiiinee.
	Rebeka: Do you want to come with me?
	* Follow -> follow
	* Don't follow -> dont_follow
===

=== goodbye
	$player: Baii :3
	Rebeka: Goodbye.
==="
