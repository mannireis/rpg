[node name="MothGirl" unique_id=1818552278 node_paths=PackedStringArray("area2d", "animation") instance=ExtResource("1_qrja6")]
npc_name = &"Kira"
dialogue = "=== start
	$player: Hey! I was passing through while looking for my bunny and I was wondering if you have seen him wondering around here?
	Kira: Hmm I've seen a few bunny's passing but mayhaps how does he look like?
	$player: He is white with a top hat and a monocle.
	Kira: I think he went North-East with someone else, perhaps will or flicker know something.
	$player: Thank you! Also I don't think I've properly introduced myself I'm $player, what about you?
	Kira: I'm Kira, the leader of this caravan.
	Kira: We are actually going North-East if you would like to come with us.
	Kira: We will take you if you bring 3 moulberrys.
	* Will bring soon -> bring
	* No thank you -> start_battle
===

=== met
	Kira: Have you come to bring me the moulberrys?
	* Yes -> yes
	* No -> end
===

=== yes
	Kira: Thank You!
==="
