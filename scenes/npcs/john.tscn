[node name="John" unique_id=882744793 instance=ExtResource("1_qrja6")]
script = ExtResource("1_eub7a")
dialogue = "=== meet_john
	$player: uhh hi?
	* Ask about bunny -> bunny
	* Where am I? -> where
	* Who are you? -> who
	* Bye -> bye
===

=== bunny
	$player: Have you seen a white bunny with a black top hat and a monocle around here?
	John: I saw him.
	$player: Where was he headed?
	John: To the land where the snow doesen't melt, 2 feet, 4 paws.
	$player: What?
	John: ...
	>> meet_john
===

=== john
	John: Hey. How are you doing?
	$player: haiii.
	>> bye
===

=== where
	John: You are in [wave amp=10 freq=5]The Crypt[/wave]
	$player: [wave amp=10 freq=5]The Crypt?[/wave]
	John: [wave amp=10 freq=5]You'll find out more when you have advanced more...[/wave]
	>> meet_john
===

=== who
	John: I'm the one who walks north, comes back, still here.
	$player: I just wanted to know your name.
	John: I'm John what about you?
	$player: I'm $player.
	>> meet_john
===

=== bye
	$player: Goodbye!
	John: Farewell.
==="
id = &"meet_john"
met_id = &"john"
metadata/_custom_type_script = "uid://cvq1dc601nuk2"

