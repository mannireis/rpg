[node name="Will" unique_id=1932718674 node_paths=PackedStringArray("area2d") instance=ExtResource("1_qrja6")]
dialogue = "=== start
	$player: Hey there! Who are you?
	Will: [wave amp=10 freq=3][rainbow freq=0.5 sat=0.8 val=1.0]Will. Will of the Wisp[/rainbow][/wave], for formal occasions.
	Will: What are you doing here?
	$player: I found this strange looking cave when I was looking for my pet bunny in the forest near my house.
	$player: I went inside and found this weird place. Someone by the name John told me I'm in [wave amp=10 freq=5]The Crypt[/wave], which didn't help me much...
	Will: Oh no... If it could help, I have seen a creature like that hopping around!
	Will: I think it went to find a warmer spot. Maybe Flicker could know more?
	$player: Thank you!
===

=== met
	Will: [wave amp=10 freq=3][rainbow freq=0.5 sat=0.8 val=1.0]✨✨✨[/rainbow][/wave]
==="
