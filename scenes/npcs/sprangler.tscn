[node name="Sprangler" unique_id=1040220559 node_paths=PackedStringArray("area2d") instance=ExtResource("1_qrja6")]
script = ExtResource("1_p76rt")
npc_name = &"The Sprangler"
dialogue = "=== start
	$player: Hey! Would it be possible for me to pass through?
	Sprangler: Why should I let you pass?
	* You are very cute! -> cute
	* Looking for bunny. -> bunny
	* You just should! -> just
===

=== cute
	Spangler: Hmmm I might let you pass if you solve my riddle what is
	Spangler: [wave amp=50.0 freq=5.0 connected=1][rainbow freq=1.0 sat=0.8 val=0.8 speed=1.0]Voiceless it cries, wingless flutters, toothless bites, mouthless mutters.[/rainbow][/wave]
	* {wind, correct, wrong}
===

=== bunny
	Spangler: You must first solve my riddle.
	$player: What riddle?
	Spangler OMG! Have patience.
	$player: Sorry.
	Spangler: So the riddle goes.
	Spangler: [wave amp=50.0 freq=5.0 connected=1][rainbow freq=1.0 sat=0.8 val=0.8 speed=1.0]What jumps around that is not wet.[/rainbow][/wave]
	* {bunny, correct, wrong}
===

=== just
	Sprangler: Grhh I'm not letting you just pass.
	$player: Pleaseee.
	Sprangler: Let's battle.
	>> battle_init[0]
===

=== wrong
	Sprangler: You lost by failing the riddle.
	Sprangler: I'm making you battle me!
	$player: nooo :<
	>> battle_init[0]
===

=== met
	Sprangler: You may pass through for now..
	$player: Thank you.
===

=== correct
	Sprangler: hmm looks like you got the correct one.
	Sprangler: I'll let you pass thru...
==="
